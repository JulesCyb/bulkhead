# --- App ---
APP_NAME=ai-app
# The startup guard refuses AUTH_MODE=dev-headers unless ENVIRONMENT is dev or test.
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Compose interpolates these three into docker-compose.yml (defaults shown). If you change
# them, mirror the new passwords in the URLs below.
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=app
# app_owner: owns every object in the database, runs migrations and seeding. No superuser, no
# BYPASSRLS — it is not the cluster's bootstrap superuser (see docker/postgres/01-init.sh).
APP_OWNER_DB_PASSWORD=app_owner
# The model gateway's own role/database password (Spec 7 / #51) — a separate database the
# gateway owns; it never sees the application database or its credential.
GATEWAY_DB_PASSWORD=gateway
# App role: no superuser, NOBYPASSRLS — Row-Level Security only applies this way
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Owner role for migrations and seed only — never the cluster superuser. Read by
# app.migration_settings (migrations/env.py, scripts/seed.py) only — it is not a field on
# app.config.Settings, so the long-running API process can never read it (issue #14 / ADR-0011).
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://app_owner:app_owner@localhost:5432/app
# Pool sizing (per worker process) and per-transaction statement timeout (ms) — explicit
# deployment settings instead of driver defaults (Spec 7). Concurrency ceiling ~= pool size +
# max overflow, per worker.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
# Role-level settings for the `app` role (docker/postgres/01-init.sh), independent of
# DB_STATEMENT_TIMEOUT_MS above — a deployment-wide default/ceiling.
APP_STATEMENT_TIMEOUT_MS=60000
APP_CONNECTION_LIMIT=50

# --- Models (provider abstraction, see app/llm.py) ---
# Model name in PydanticAI format "<provider>:<model>"; use a current model
LLM_MODEL=anthropic:claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: route everything through the LiteLLM gateway. Then use the alias names from
# docker/litellm/config.yaml: LLM_MODEL=openai:claude and EMBEDDING_MODEL=embeddings
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Required (ADR-0009): the gateway is a required service, not an optional profile. This is its
# admin key — mint per-tenant virtual keys with it. Rendering docker-compose.yml fails if unset.
LITELLM_MASTER_KEY=
# Embeddings (OpenAI-compatible, optionally via LiteLLM); dimension must match the migration (1536)
# No default any more (ADR-0008): a deployment with no embedding provider/model configured must
# refuse to start rather than silently reaching a default endpoint. Fill both in explicitly.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# --- Residency (ADR-0008) ---
# Which jurisdiction this deployment's content-bearing traffic (model/gateway, embedding,
# tracing) is allowed to reach. Must be a key of RESIDENCY_ALLOW_LIST in app/config.py — that
# dict is the single place listing residencies and their allowed endpoints; add a residency
# there, not by scattering per-provider defaults across modules.
RESIDENCY=eu

# --- Per-tenant gateway credentials (app/gateway_credentials.py, Spec 7 / #52, ADR-0011) ---
# Directory holding one file per gateway-credential alias, resolved fresh per request from the
# control plane's own alias -- never loaded once at startup like the fields above. Same default
# location as pydantic-settings' own SECRETS_DIR, different lookup key (an alias, not a field
# name) and lifetime (per request, not per process).
GATEWAY_CREDENTIALS_DIR=/run/secrets

# --- Per-membership request limit (app/request_limit.py) ---
# Single-process, best-effort backstop on /agents/assistant/run, /agents/assistant/stream, and
# /api/chat, keyed on (tenant_id, identity_id). NOT the enforcement of record for spend — that is the
# model gateway's own per-tenant budget; this only slows a stuck client or a scripted flood
# before it can dent that budget. A multi-replica deployment needs a shared store for the same
# guarantee across replicas (not implemented here).
REQUEST_LIMIT_MAX=30
REQUEST_LIMIT_WINDOW_SECONDS=60

# --- Auth (DEV) ---
# dev-headers: X-Tenant-Id / X-Identity-Id on the request. Replace with JWT/OIDC before production (app/deps.py).
AUTH_MODE=dev-headers

# --- Observability (Langfuse via OTel, optional) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- MCP server (DEV: context from the environment; from auth in production) ---
MCP_TENANT_ID=
MCP_IDENTITY_ID=

# --- Identity (AUTH_MODE=jwt; issue #22 / ADR-0003) ---
# Process-wide fallback token issuer, used for any tenant whose control-plane identity_issuer
# column is unset. Interim "one operator-run identity provider" default.
DEFAULT_IDENTITY_ISSUER=
