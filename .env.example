# --- App ---
APP_NAME=ai-app
# The startup guard refuses AUTH_MODE=dev-headers unless ENVIRONMENT is dev or test.
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Compose interpolates these two into docker-compose.yml (defaults shown). If you change
# them, mirror the new passwords in the URLs below.
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=app
# App role: no superuser, NOBYPASSRLS — Row-Level Security only applies this way
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Owner/superuser role for migrations and seed only
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# --- Models (provider abstraction, see app/llm.py) ---
# Model name in PydanticAI format "<provider>:<model>"; use a current model
LLM_MODEL=anthropic:claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: route everything through the LiteLLM gateway. Then use the alias names from
# docker/litellm/config.yaml: LLM_MODEL=openai:claude and EMBEDDING_MODEL=embeddings
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Required for the gateway profile: LiteLLM's admin key (mint per-tenant virtual keys with it)
LITELLM_MASTER_KEY=
# Embeddings (OpenAI-compatible, optionally via LiteLLM); dimension must match the migration (1536)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Run limits (ADR-0009): the ceiling one agent run may consume, not a budget ---
# "Order of ten model requests and twenty tool calls" is a starting default — tune per deployment.
RUN_REQUEST_LIMIT=10
RUN_TOOL_CALLS_LIMIT=20
RUN_TOTAL_TOKENS_LIMIT=
RUN_DEADLINE_SECONDS=60

# --- Auth (DEV) ---
# dev-headers: X-Tenant-Id / X-User-Id on the request. Replace with JWT/OIDC before production (app/deps.py).
AUTH_MODE=dev-headers

# --- Observability (Langfuse via OTel, optional) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- MCP server (DEV: context from the environment; from auth in production) ---
MCP_TENANT_ID=
MCP_USER_ID=
