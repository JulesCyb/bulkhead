# --- App ---
APP_NAME=ai-app
# The startup guard refuses AUTH_MODE=dev-headers unless ENVIRONMENT is dev or test.
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Compose interpolates these three into docker-compose.yml (defaults shown). If you change
# them, mirror the new passwords in the URLs below.
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=app
# app_owner: owns every object in the database, runs migrations and seeding. No superuser, no
# BYPASSRLS — it is not the cluster's bootstrap superuser (see docker/postgres/01-init.sh).
APP_OWNER_DB_PASSWORD=app_owner
# The model gateway's own role/database password (Spec 7 / #51) — a separate database the
# gateway owns; it never sees the application database or its credential.
GATEWAY_DB_PASSWORD=gateway
# App role: no superuser, NOBYPASSRLS — Row-Level Security only applies this way
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Owner role for migrations and seed only — never the cluster superuser. Read by
# app.migration_settings (migrations/env.py, scripts/seed.py) only — it is not a field on
# app.config.Settings, so the long-running API process can never read it (issue #14 / ADR-0011).
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://app_owner:app_owner@localhost:5432/app
# Pool sizing (per worker process) and per-transaction statement timeout (ms) — explicit
# deployment settings instead of driver defaults (Spec 7). Concurrency ceiling ~= pool size +
# max overflow, per worker.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
# Role-level settings for the `app` role (docker/postgres/01-init.sh), independent of
# DB_STATEMENT_TIMEOUT_MS above — a deployment-wide default/ceiling.
APP_STATEMENT_TIMEOUT_MS=60000
APP_CONNECTION_LIMIT=50

# --- Models (provider abstraction, see app/llm.py) ---
# A gateway alias from docker/litellm/config.yaml's `model_name` list (a "<provider>:<model>"
# value also works -- any "<provider>:" prefix is stripped before the alias check), and must be
# on the allow-list for RESIDENCY below (config/residency.toml). "claude-eu" matches the defaults
# here (RESIDENCY=eu).
LLM_MODEL=claude-eu
# Read only by the `litellm` gateway service in docker-compose.yml (docker/litellm/config.yaml) --
# app.config.Settings has no field for either of these, and the api container never receives
# them. Never set a provider key directly on the api service; that would be exactly the
# escape hatch ADR-0009 forbids (ai-app-starter#7 review finding).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Required (ADR-0009): every model/embedding call goes through the LiteLLM gateway, never a
# provider directly, in every environment, with no default in app.config.Settings itself
# (ai-app-starter#7): Settings refuses to construct at all -- before the API or MCP server can
# accept a single request or tool call -- if this is unset or empty. docker-compose.yml already
# defaults it to the gateway's own compose hostname (http://litellm:4000) for you; set it
# explicitly for any other deployment. Use the alias names from docker/litellm/config.yaml, e.g.
# EMBEDDING_MODEL=embeddings.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=
# Required (ADR-0009): the gateway is a required service, not an optional profile. This is its
# admin key — mint per-tenant virtual keys with it. Rendering docker-compose.yml fails if unset.
# Also read by app.gateway_provisioning (Spec 7 / #53) to mint/revoke a tenant's own credential —
# scripts/seed.py needs this set to produce a tenant that can actually call the assistant.
LITELLM_MASTER_KEY=
# Embeddings (OpenAI-compatible, always via the LiteLLM gateway); dimension must match the migration (1536)
# No default any more (ADR-0008): a deployment with no embedding provider/model configured must
# refuse to start rather than silently reaching a default endpoint. Fill both in explicitly.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# --- Residency (ADR-0008) ---
# Which jurisdiction this deployment's content-bearing traffic (model/gateway, embedding,
# tracing) is allowed to reach. Must be a key of RESIDENCY_ALLOW_LIST, loaded from
# config/residency.toml (RESIDENCY_CONFIG_PATH below) — that file is the single place listing
# residencies and their allowed endpoints; add a residency there (a new [residency.<name>] table,
# see docs/residency.md), not by scattering per-provider defaults across modules.
RESIDENCY=eu
# Where the residency allow-list file lives. Commented out (not set to an empty value -- an
# empty RESIDENCY_CONFIG_PATH would override the default with a blank path and fail to load) so
# the shipped config/residency.toml is used; uncomment and set only if your deployment renders
# this file to a different path.
# RESIDENCY_CONFIG_PATH=/etc/ai-app/residency.toml

# --- Per-tenant gateway credentials (app/gateway_credentials.py, Spec 7 / #52, ADR-0011) ---
# Directory holding one file per gateway-credential alias, resolved fresh per request from the
# control plane's own alias -- never loaded once at startup like the fields above. Same default
# location as pydantic-settings' own SECRETS_DIR, different lookup key (an alias, not a field
# name) and lifetime (per request, not per process).
GATEWAY_CREDENTIALS_DIR=/run/secrets

# --- Per-alias migration secrets (scripts/migrate.py, Spec 10 / #76, ADR-0002/ADR-0011) ---
# Directory holding one file per dedicated database alias, each an owner-role DSN -- never the
# same directory or file as a tenant's app-role secret (app/db/engine_registry.py's
# TENANT_DB_SECRETS_DIR): migrations run as the owner role, the running application never does.
# Read only by scripts/migrate.py, and only for an alias other than "pooled" (that one always
# uses DATABASE_URL_MIGRATIONS above).
TENANT_DB_MIGRATIONS_SECRETS_DIR=/run/secrets/tenant-db-migrations

# Default budget/rate limit a newly provisioned tenant's gateway credential is minted with
# (app/gateway_provisioning.py, Spec 7 / #53) — starting defaults, tune per deployment.
GATEWAY_DEFAULT_SPEND_CEILING_USD=50.0
GATEWAY_DEFAULT_BUDGET_RESET_PERIOD=30d
GATEWAY_DEFAULT_REQUESTS_PER_MINUTE=60
GATEWAY_DEFAULT_TOKENS_PER_MINUTE=100000

# How long, in days, the deployment's backup system keeps the last copy of a tenant's data after
# the operator tool's `erase` command removes it everywhere else (app/config.py, Spec 9 / #72,
# ADR-0010) -- written onto each erasure record as the true erasure deadline, never acted on here.
BACKUP_RETENTION_DAYS=30

# --- Per-membership request limit (app/request_limit.py) ---
# Single-process, best-effort backstop on /agents/assistant/run, /agents/assistant/stream, and
# /api/chat, keyed on (tenant_id, identity_id). NOT the enforcement of record for spend — that is the
# model gateway's own per-tenant budget; this only slows a stuck client or a scripted flood
# before it can dent that budget. A multi-replica deployment needs a shared store for the same
# guarantee across replicas (not implemented here).
REQUEST_LIMIT_MAX=30
REQUEST_LIMIT_WINDOW_SECONDS=60

# --- Run limits (ADR-0009): the ceiling one agent run may consume, not a budget ---
# "Order of ten model requests and twenty tool calls" is a starting default — tune per deployment.
RUN_REQUEST_LIMIT=10
RUN_TOOL_CALLS_LIMIT=20
RUN_TOTAL_TOKENS_LIMIT=
RUN_DEADLINE_SECONDS=60

# --- Auth (DEV) ---
# dev-headers: X-Tenant-Id / X-Identity-Id on the request. Replace with JWT/OIDC before production (app/deps.py).
AUTH_MODE=dev-headers

# --- Observability (Langfuse via OTel, optional) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- MCP server (issue #48 / ADR-0005) ---
# stdio (default): local development only, context from MCP_TENANT_ID/MCP_IDENTITY_ID below.
# Refused outside dev/test the same way AUTH_MODE=dev-headers is. streamable-http: production,
# per-connection identity from a verified token -- requires JWT_VERIFICATION_KEY below.
MCP_TRANSPORT=stdio
MCP_TENANT_ID=
MCP_IDENTITY_ID=

# --- Identity (AUTH_MODE=jwt; issue #22 / ADR-0003) ---
# Process-wide fallback token issuer, used for any tenant whose control-plane identity_issuer
# column is unset. Interim "one operator-run identity provider" default.
DEFAULT_IDENTITY_ISSUER=

# --- JWT verification for HUMAN (tenant-IdP) tokens (AUTH_MODE=jwt; issue #24 / ADR-0003 /
# ADR-0012) ---
# The process-wide verification key (interim, same "one operator-run identity provider" case as
# DEFAULT_IDENTITY_ISSUER above) for tokens minted by a real, external identity provider. A real
# IdP signs asymmetrically -- this is its PUBLIC key (PEM) only, never a secret this deployment
# could forge a token with. Set JWT_ALGORITHM=HS256 (and this to a shared secret) only for a
# same-process/dev-only IdP stand-in. No default -- AUTH_MODE=jwt with this unset rejects every
# request as unauthenticated rather than accepting unverifiable tokens.
JWT_VERIFICATION_KEY=
JWT_ALGORITHM=RS256

# --- Agent-credential token exchange for AGENT tokens (Spec 6 / #47, ADR-0005) ---
# A DIFFERENT algorithm/key pair from JWT_VERIFICATION_KEY/JWT_ALGORITHM above, on purpose (review
# finding, Spec 6): this application mints these tokens itself for its own agent identities, and
# is both signer and verifier -- there is no external IdP to keep a private key from. Sharing one
# algorithm setting between a real (asymmetric) IdP and this app-minted, symmetric case is exactly
# the misconfiguration that breaks every agent token the moment JWT_ALGORITHM is set to a real
# IdP's RS256/ES256 -- keep the two independent.
#
# AGENT_TOKEN_ALGORITHM=HS256 (the default): AGENT_TOKEN_SIGNING_KEY is a shared secret, used for
# both minting and verifying -- must be at least 32 random bytes (e.g. `openssl rand -hex 32`); a
# shorter secret fails startup.
# An asymmetric AGENT_TOKEN_ALGORITHM (RS256/ES256/...): AGENT_TOKEN_SIGNING_KEY must be a PEM
# private key; AGENT_TOKEN_VERIFICATION_KEY (its matching public key) is derived automatically if
# left unset, or set it explicitly when the private key isn't this process's to hold.
# No default for AGENT_TOKEN_SIGNING_KEY -- an unconfigured signing key fails every exchange
# rather than minting an unsigned or otherwise weak token.
AGENT_TOKEN_SIGNING_KEY=
AGENT_TOKEN_ALGORITHM=HS256
AGENT_TOKEN_VERIFICATION_KEY=
AGENT_TOKEN_TTL_SECONDS=300
